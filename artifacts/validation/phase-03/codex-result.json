  "findings": [
    {"severity": "P1", "summary": "TenantProvisioner seeded only OWNER/OPERATOR/VIEWER, so a tenant created after migration 0003 had no DEPUTY role and no approval.decide mapping: every R2 and R3 action in a new tenant would stay PENDING forever.", "disposition": "RESOLVED", "owner": "Nikola", "target": "Phase 03 amendment A-6", "evidence_path": "artifacts/validation/phase-03/security-tests.log"},
    {"severity": "P1", "summary": "Migration 0003 recorded a role id in role_permissions.granted_by, violating fk_role_permissions_grantor. It passed only because the migration had never run against a database containing a tenant.", "disposition": "RESOLVED", "owner": "Nikola", "target": "Phase 03", "evidence_path": "artifacts/validation/phase-03/security-tests.log"},
    {"severity": "P1", "summary": "Migration 0003's tenant-scoped seeding and downgrade cleanup were silent no-ops: nexora_migrator holds no BYPASSRLS and matched zero rows without a signed context.", "disposition": "RESOLVED", "owner": "Nikola", "target": "Phase 03", "evidence_path": "artifacts/validation/phase-03/security-tests.log"},
    {"severity": "P2", "summary": "may_decide treated approval.decide.high as an R3 gate, which would have made ADR-004 approval paths 4 and 5 unreachable.", "disposition": "RESOLVED", "owner": "Nikola", "target": "Phase 03", "evidence_path": "artifacts/validation/phase-03/phase-review.log"},
    {"severity": "P3", "summary": "Validator assertions compared against module constants after the expected sets became parameters, and one new Phase-03 assertion had a set-operator precedence bug.", "disposition": "RESOLVED", "owner": "Nikola", "target": "Phase 03", "evidence_path": "artifacts/validation/phase-03/migration-check.log"}
  ],
