  "known_limitations": [
    {"summary": "No HTTP authentication boundary. /approvals and /chat both require a trusted ActorContext on request.state.actor; Phase-03 security properties are proved at the service boundary, not over HTTP.", "owner": "Nikola", "target": "Phase 04 (amendment A-3)"},
    {"summary": "The EUR 10000 threshold's measurement rule (net or gross, currency, conversion) is HD-004. Phase 03 implements the comparison and tests both sides against fixture amounts only.", "owner": "Nikola", "target": "Phase 04"},
    {"summary": "Auth0 MFA step-up is consumed as ActorContext.assurance. No real MFA challenge is issued or verified by this phase, and ADR-004 makes step-up the only barrier against a compromised OWNER or DEPUTY.", "owner": "Nikola", "target": "Phase 04 or Phase 08"},
    {"summary": "approval.decide.high is granted and implies approval.decide, but no rule currently requires it: composition is what restricts R3. It is carried as future-proofing rather than an active control.", "owner": "Nikola", "target": "Phase 04"},
    {"summary": "Amendment A-5 extended a Phase-01 security test's exact grant set, and EXPECTED_PHASE_03_CATALOG_SHA256 is an agent-generated baseline. Both need Nikola's confirmation during UAT.", "owner": "Nikola", "target": "P03-UAT-01"},
    {"summary": "The ADR-004 TTL table is indexed by approval path, but a TTL must be fixed at request creation before any path is known. approval_ttl derives it from requester authority and amount; that derivation is the agent's reading of the decision, not a stated rule.", "owner": "Nikola", "target": "P03-UAT-01"}
  ]
