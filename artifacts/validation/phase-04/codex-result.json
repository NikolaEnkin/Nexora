  "known_limitations": [
    {
      "summary": "The Auth0 step-up round trip is not implemented. No Auth0 tenant is configured and the project forbids production credentials in tests, so Auth0StepUpVerifier.verify raises NotImplementedError rather than returning a stub that would make the suite green while the control did not exist. The factor policy, the five-minute window, the recording and the per-request derivation are all real and tested.",
      "owner": "Nikola",
      "target": "whichever phase provisions the Auth0 tenant"
    },
    {
      "summary": "No financial capability exists. Amendment A-4 removed the offer, invoice and payment tools, their tables and their status enums from Phase 04 pending an accepted HD-004 ADR. _assert_phase04_boundary in the migration check actively asserts those tables do not exist.",
      "owner": "Nikola",
      "target": "a later phase, number and branch to be assigned"
    },
    {
      "summary": "Amendments A-3, A-4 and A-5 all carry open signature lines. A-3 extended the migration validator and one Phase-01 grant assertion additively; A-4 is the descope itself; A-5 lists six paths touched outside the literal allowlist.",
      "owner": "Nikola",
      "target": "human review of Phase 04"
    },
